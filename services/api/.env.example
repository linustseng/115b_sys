# Server
PORT=8080
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
DATABASE_SSL=true

# Runtime mode
# - STRICT_NODE_ONLY=1 keeps production traffic on Node API only.
STRICT_NODE_ONLY=1

# Legacy Google migration tooling only (not used by production runtime)
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec
APPS_SCRIPT_TIMEOUT_MS=20000
SYNC_PULL_TOKEN=replace-with-random-hex

# Auth/session
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
SESSION_SECRET=replace-with-random-hex

# Drive uploads (base64-encoded service account JSON)
DRIVE_FINANCE_FOLDER_ID=1Gkw7MzeEpFV9gAnNP9xNIM8MkiarAms8
DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
