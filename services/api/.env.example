# Server
PORT=8080
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
DATABASE_SSL=true

# Runtime mode
# - STRICT_NODE_ONLY=1 keeps production traffic on Node API only.
STRICT_NODE_ONLY=1

# Auth/session
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
SESSION_SECRET=replace-with-random-hex

# Drive uploads (base64-encoded service account JSON)
DRIVE_FINANCE_FOLDER_ID=1Gkw7MzeEpFV9gAnNP9xNIM8MkiarAms8
DRIVE_SERVICE_ACCOUNT_JSON_BASE64=

# Academics
# Private ICS URL from Google Calendar (server-side only; do not expose to frontend)
ACADEMICS_ICS_URL=https://calendar.google.com/calendar/ical/d07db9571997a7592737ae50fc3062ab8a1105d0e3b794ded9672b1e6cd0502a%40group.calendar.google.com/public/basic.ics
# Optional: background sync interval in minutes (default: 180)
ACADEMICS_AUTO_SYNC_INTERVAL_MINUTES=180
